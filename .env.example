# Server-side only. Never prefix this variable with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.5.
OPENAI_MODEL=gpt-5.5

# Production generation requires a signed-in ChatGPT user by default.
# Set this only if public, rate-limited generation is intentional.
FISHY_ALLOW_ANONYMOUS_GENERATION=false

# Optional comma-separated oai-authenticated-user-id allowlist.
FISHY_ALLOWED_USER_IDS=
